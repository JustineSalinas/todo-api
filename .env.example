# Copy this file to .env and adjust if needed. .env itself is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks

# Used by the app. Inside docker compose the host is the service name "db";
# running the app on your host machine against the container's published
# port, use "localhost" instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks

PORT=3000
